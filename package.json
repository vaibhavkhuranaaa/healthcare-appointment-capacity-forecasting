{
  "name": "gp-access-planner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker:types": "wrangler types worker/env.d.ts --config worker/wrangler.jsonc",
